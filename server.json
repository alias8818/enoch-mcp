{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alias8818/enoch",
  "title": "Enoch",
  "description": "Operate an Enoch control plane through MCP tools",
  "version": "0.1.1",
  "websiteUrl": "https://github.com/alias8818/enoch-mcp",
  "repository": {
    "url": "https://github.com/alias8818/enoch-mcp",
    "source": "github",
    "id": "1226764732"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "enoch-mcp",
      "version": "0.1.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ENOCH_API_URL",
          "description": "Base URL for the Enoch API.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "default": "http://localhost:8787"
        },
        {
          "name": "ENOCH_API_TOKEN",
          "description": "Bearer token for the Enoch API.",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
